        type: 3}
      propertyPath: 'sentences.Array.data[1]'
      value: "\u0E2D\u0E22\u0E32\u0E01\u0E44\u0E1B\u0E2B\u0E32\u0E44\u0E2D\u0E15\u0E34\u0E21\u0E01\u0E34\u0E19\u0E27\u0E48\u0E30"
